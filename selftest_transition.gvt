gravitino-transition 1

[meta]
name        = selftest blend
author      = selftest

[from]
title       = Demo Track 1
bpm         = 127.99
duration    = 0.00

[to]
title       = Demo Track 2
bpm         = 119.98
duration    = 0.00

[sync]
anchor_from = 16.0      ; beat in FROM track where the transition begins
anchor_to   = 0.0       ; beat in TO track aligned to transition beat 0
master_bpm  = 127.99    ; tempo the mix runs at during the transition

[events]
; beat | target | control | value | curve
0.000    b        tempo_sync
0.000    b        fader       1.00
0.000    b        eq_low      0.00
0.000    b        play
0.000    x        xfader      0.00
12.000   x        xfader      1.00   linear
12.000   b        eq_low      0.50   linear
14.000   a        stop
